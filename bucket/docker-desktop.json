{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "4.87.0",
    "description": "Docker Desktop for Windows. Easy-to-install application for building and sharing containerized applications and microservices (per-user installation).",
    "homepage": "https://www.docker.com/products/docker-desktop/",
    "license": "Proprietary",
    "notes": "Docker Desktop requires WSL 2 or Hyper-V enabled on Windows.",
    "architecture": {
        "64bit": {
            "url": "https://desktop.docker.com/win/main/amd64/Docker%20Desktop%20Installer.exe#/installer.exe",
            "hash": "9ac03d4e900c0fdee981d4bde083a55fdfb28ffba2cae77726eff2a437254822"
        }
    },
    "installer": {
        "file": "installer.exe",
        "args": [
            "install",
            "--quiet",
            "--accept-license",
            "--user"
        ]
    },
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    if (Test-Path \"$env:LOCALAPPDATA\\Programs\\DockerDesktop\\Docker Desktop Installer.exe\") {",
            "        Start-Process \"$env:LOCALAPPDATA\\Programs\\DockerDesktop\\Docker Desktop Installer.exe\" -ArgumentList 'uninstall', '--quiet' -Wait",
            "    } elseif (Test-Path \"$env:LOCALAPPDATA\\Programs\\Docker\\Docker\\Docker Desktop Installer.exe\") {",
            "        Start-Process \"$env:LOCALAPPDATA\\Programs\\Docker\\Docker\\Docker Desktop Installer.exe\" -ArgumentList 'uninstall', '--quiet' -Wait",
            "    }",
            "}"
        ]
    },
    "checkver": {
        "url": "https://docs.docker.com/desktop/release-notes.md",
        "regex": "## ([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://desktop.docker.com/win/main/amd64/Docker%20Desktop%20Installer.exe#/installer.exe"
            }
        }
    }
}
