{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "149.0.7827.202",
    "description": "Cốc Cốc Browser. Trình duyệt web dành cho người Việt.",
    "homepage": "https://coccoc.com/",
    "license": "Proprietary",
    "notes": [
        "Cốc Cốc has been installed silently.",
        "The following 3 options were automatically unchecked/disabled:",
        "  - Make Cốc Cốc default browser",
        "  - Make Cốc Cốc default PDF reader",
        "  - Run browser on system start"
    ],
    "architecture": {
        "64bit": {
            "url": "https://files.coccoc.com/browser/download/vi?plat=win&arch=x64#/CocCocSetup.exe",
            "hash": "7bd45b747077934cb5d27f6d68294b9b60b690639ae5cdfc9601e733493bc9e5"
        },
        "32bit": {
            "url": "https://files.coccoc.com/browser/download/vi?plat=win&arch=#/CocCocSetup.exe",
            "hash": "ca35d452a235095455a67263895195dbebbfa8b962fe11c2ad63d1d10f2dfe06"
        }
    },
    "installer": {
        "file": "CocCocSetup.exe",
        "args": [
            "/silent",
            "/install"
        ]
    },
    "post_install": [
        "Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'CocCoc*', 'CocCocUpdate*' -ErrorAction SilentlyContinue",
        "Get-ScheduledTask -TaskPath '\\*' -ErrorAction SilentlyContinue | Where-Object { $_.TaskName -like '*CocCoc*' } | Disable-ScheduledTask -ErrorAction SilentlyContinue",
        "Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\FileExts\\.pdf\\UserChoice' -Name 'ProgId' -ErrorAction SilentlyContinue",
        "Get-Process -Name '*coccoc*', 'browser' -ErrorAction SilentlyContinue | Where-Object { $_.Path -like '*CocCoc*' } | Stop-Process -Force -ErrorAction SilentlyContinue"
    ],
    "uninstaller": {
        "script": [
            "$regPaths = @(",
            "    'HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*',",
            "    'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*',",
            "    'HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*'",
            ")",
            "$entry = $regPaths | ForEach-Object { Get-ItemProperty $_ -ErrorAction SilentlyContinue } | Where-Object { $_.DisplayName -match 'Coc' } | Select-Object -First 1",
            "if ($entry -and $entry.UninstallString) {",
            "    $uninstallCmd = $entry.UninstallString -replace '\"', ''",
            "    Start-Process $uninstallCmd -ArgumentList '--uninstall', '--force-uninstall' -Wait",
            "}"
        ]
    },
    "checkver": {
        "script": [
            "$url = 'https://files.coccoc.com/browser/download/vi?plat=win&arch=x64'",
            "$tempFile = Join-Path $env:TEMP 'coccoc_checkver.exe'",
            "Invoke-WebRequest -Uri $url -OutFile $tempFile -UseBasicParsing",
            "$version = (Get-Item $tempFile).VersionInfo.FileVersion",
            "Remove-Item $tempFile -Force",
            "Write-Output $version"
        ],
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://files.coccoc.com/browser/download/vi?plat=win&arch=x64#/CocCocSetup.exe"
            },
            "32bit": {
                "url": "https://files.coccoc.com/browser/download/vi?plat=win&arch=#/CocCocSetup.exe"
            }
        }
    }
}
