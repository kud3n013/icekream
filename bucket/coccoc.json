{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "151.0.7922.140",
    "description": "Cốc Cốc Browser. Trình duyệt web dành cho người Việt.",
    "homepage": "https://coccoc.com/",
    "license": "Proprietary",
    "notes": [
        "Cốc Cốc has been installed silently.",
        "The following 3 options were automatically unchecked/disabled:",
        "  - Make Cốc Cốc default browser",
        "  - Make Cốc Cốc default PDF reader",
        "  - Run browser on system start"
    ],
    "architecture": {
        "64bit": {
            "url": "https://files.coccoc.com/browser/download/vi?plat=win&arch=x64#/CocCocSetup.exe",
            "hash": "896fd9408e371de759c670a4c44afea19c7a7a1baacc25f5ad2125396879d651"
        },
        "32bit": {
            "url": "https://files.coccoc.com/browser/download/vi?plat=win&arch=#/CocCocSetup.exe",
            "hash": "ad7699f9edf41bd55cacd79ef9e5dc09914ddb2b3beaaeb479f23dffa3773eb4"
        }
    },
    "installer": {
        "script": [
            "$exe = \"$dir\\CocCocSetup.exe\"",
            "$proc = Start-Process $exe -PassThru",
            "Write-Host 'Waiting for Cốc Cốc installer UI...'",
            "if (-not ('WinAPI_CocCoc_v4' -as [type])) {",
            "    $code = @'",
            "    using System;",
            "    using System.Runtime.InteropServices;",
            "    using System.Text;",
            "    public class WinAPI_CocCoc_v4 {",
            "        public static IntPtr FoundHWnd = IntPtr.Zero;",
            "        public delegate bool EnumWindowsProc(IntPtr hWnd, IntPtr lParam);",
            "        [DllImport(\"user32.dll\")] public static extern bool EnumWindows(EnumWindowsProc lpEnumFunc, IntPtr lParam);",
            "        [DllImport(\"user32.dll\", CharSet=CharSet.Auto)] public static extern int GetClassName(IntPtr hWnd, StringBuilder lpClassName, int nMaxCount);",
            "        [DllImport(\"user32.dll\")] public static extern IntPtr GetDlgItem(IntPtr hDlg, int nIDDlgItem);",
            "        [DllImport(\"user32.dll\", CharSet=CharSet.Auto)] public static extern IntPtr SendMessage(IntPtr hWnd, uint Msg, IntPtr wParam, IntPtr lParam);",
            "        [DllImport(\"user32.dll\")] public static extern bool IsWindow(IntPtr hWnd);",
            "    }",
            "'@",
            "    Add-Type $code",
            "}",
            "[WinAPI_CocCoc_v4]::FoundHWnd = [IntPtr]::Zero",
            "for ($i = 0; $i -lt 40; $i++) {",
            "    Start-Sleep -Seconds 1",
            "    [WinAPI_CocCoc_v4]::EnumWindows({",
            "        param($hwnd2, $lparam)",
            "        $class = New-Object System.Text.StringBuilder 256",
            "        [WinAPI_CocCoc_v4]::GetClassName($hwnd2, $class, 256) | Out-Null",
            "        if ($class.ToString() -eq '#32770') {",
            "            $btn = [WinAPI_CocCoc_v4]::GetDlgItem($hwnd2, 3100)",
            "            $cb1 = [WinAPI_CocCoc_v4]::GetDlgItem($hwnd2, 3116)",
            "            if ($btn -ne [IntPtr]::Zero -or $cb1 -ne [IntPtr]::Zero) {",
            "                [WinAPI_CocCoc_v4]::FoundHWnd = $hwnd2",
            "                return $false",
            "            }",
            "        }",
            "        return $true",
            "    }, [IntPtr]::Zero) | Out-Null",
            "    if ([WinAPI_CocCoc_v4]::FoundHWnd -ne [IntPtr]::Zero) { break }",
            "}",
            "$hWnd = [WinAPI_CocCoc_v4]::FoundHWnd",
            "if ($hWnd -eq [IntPtr]::Zero) { Write-Host 'Could not find installer window'; exit 1 }",
            "Write-Host 'Found installer window, automating clicks...'",
            "$cb1 = [WinAPI_CocCoc_v4]::GetDlgItem($hWnd, 3116)",
            "$cb2 = [WinAPI_CocCoc_v4]::GetDlgItem($hWnd, 3118)",
            "$cb3 = [WinAPI_CocCoc_v4]::GetDlgItem($hWnd, 3119)",
            "$btn = [WinAPI_CocCoc_v4]::GetDlgItem($hWnd, 3100)",
            "$BM_CLICK = 0x00F5",
            "$WM_COMMAND = 0x0111",
            "if ($cb1 -ne [IntPtr]::Zero) { [WinAPI_CocCoc_v4]::SendMessage($cb1, $BM_CLICK, [IntPtr]::Zero, [IntPtr]::Zero) | Out-Null; [WinAPI_CocCoc_v4]::SendMessage($hWnd, $WM_COMMAND, [IntPtr]3116, $cb1) | Out-Null }",
            "if ($cb2 -ne [IntPtr]::Zero) { [WinAPI_CocCoc_v4]::SendMessage($cb2, $BM_CLICK, [IntPtr]::Zero, [IntPtr]::Zero) | Out-Null; [WinAPI_CocCoc_v4]::SendMessage($hWnd, $WM_COMMAND, [IntPtr]3118, $cb2) | Out-Null }",
            "if ($cb3 -ne [IntPtr]::Zero) { [WinAPI_CocCoc_v4]::SendMessage($cb3, $BM_CLICK, [IntPtr]::Zero, [IntPtr]::Zero) | Out-Null; [WinAPI_CocCoc_v4]::SendMessage($hWnd, $WM_COMMAND, [IntPtr]3119, $cb3) | Out-Null }",
            "Start-Sleep -Milliseconds 500",
            "if ($btn -ne [IntPtr]::Zero) { [WinAPI_CocCoc_v4]::SendMessage($btn, $BM_CLICK, [IntPtr]::Zero, [IntPtr]::Zero) | Out-Null; [WinAPI_CocCoc_v4]::SendMessage($hWnd, $WM_COMMAND, [IntPtr]3100, $btn) | Out-Null }",
            "Write-Host 'Installing...'",
            "$appPath1 = \"$env:LOCALAPPDATA\\CocCoc\\Browser\\Application\\browser.exe\"",
            "$appPath2 = \"$env:LOCALAPPDATA\\CocCoc\\Browser\\Application\\chrome.exe\"",
            "for ($t = 0; $t -lt 120; $t += 2) {",
            "    Start-Sleep -Seconds 2",
            "    if ((Test-Path $appPath1) -or (Test-Path $appPath2)) {",
            "        if (-not (Get-Process -Name 'updater', 'CocCocSetup' -ErrorAction SilentlyContinue)) { break }",
            "    }",
            "}",
            "Write-Host 'Installation finished.'"
        ]
    },
    "post_install": [
        "Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'CocCoc*', 'CocCocUpdate*' -ErrorAction SilentlyContinue",
        "Get-ScheduledTask -TaskPath '\\*' -ErrorAction SilentlyContinue | Where-Object { $_.TaskName -like '*CocCoc*' } | Disable-ScheduledTask -ErrorAction SilentlyContinue",
        "Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\FileExts\\.pdf\\UserChoice' -Name 'ProgId' -ErrorAction SilentlyContinue",
        "Get-Process -Name '*coccoc*', 'browser' -ErrorAction SilentlyContinue | Where-Object { $_.Path -like '*CocCoc*' } | Stop-Process -Force -ErrorAction SilentlyContinue"
    ],
    "uninstaller": {
        "script": [
            "$regPaths = @(",
            "    'HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*',",
            "    'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*',",
            "    'HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*'",
            ")",
            "$entry = $regPaths | ForEach-Object { Get-ItemProperty $_ -ErrorAction SilentlyContinue } | Where-Object { $_.DisplayName -match 'Coc' } | Select-Object -First 1",
            "if ($entry -and $entry.UninstallString) {",
            "    $uninstallCmd = $entry.UninstallString -replace '\"', ''",
            "    Start-Process $uninstallCmd -ArgumentList '--uninstall', '--force-uninstall' -Wait",
            "}"
        ]
    },
    "checkver": {
        "script": [
            "$url = 'https://files.coccoc.com/browser/download/vi?plat=win&arch=x64'",
            "$tempFile = Join-Path $env:TEMP 'coccoc_checkver.exe'",
            "Invoke-WebRequest -Uri $url -OutFile $tempFile -UseBasicParsing",
            "$version = (Get-Item $tempFile).VersionInfo.FileVersion",
            "Remove-Item $tempFile -Force",
            "Write-Output $version"
        ],
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://files.coccoc.com/browser/download/vi?plat=win&arch=x64#/CocCocSetup.exe"
            },
            "32bit": {
                "url": "https://files.coccoc.com/browser/download/vi?plat=win&arch=#/CocCocSetup.exe"
            }
        }
    }
}
