{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "4.93.0",
    "description": "Docker Desktop for Windows. Easy-to-install application for building and sharing containerized applications and microservices (all-users / non-portable installation).",
    "homepage": "https://www.docker.com/products/docker-desktop/",
    "license": "Proprietary",
    "notes": "Docker Desktop requires WSL 2 or Hyper-V enabled on Windows and administrative privileges for system-wide installation.",
    "architecture": {
        "64bit": {
            "url": "https://desktop.docker.com/win/main/amd64/Docker%20Desktop%20Installer.exe#/installer.exe",
            "hash": "c139124c9cf71477dc565c3c0ea5a18f90b93d68ebe9aaa848a065960416c0bc"
        }
    },
    "installer": {
        "file": "installer.exe",
        "args": [
            "install",
            "--quiet",
            "--accept-license"
        ]
    },
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    if (Test-Path \"$env:ProgramFiles\\Docker\\Docker\\Docker Desktop Installer.exe\") {",
            "        Start-Process \"$env:ProgramFiles\\Docker\\Docker\\Docker Desktop Installer.exe\" -ArgumentList 'uninstall', '--quiet' -Wait",
            "    }",
            "}"
        ]
    },
    "checkver": {
        "url": "https://docs.docker.com/desktop/release-notes.md",
        "regex": "## ([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://desktop.docker.com/win/main/amd64/Docker%20Desktop%20Installer.exe#/installer.exe"
            }
        }
    }
}
