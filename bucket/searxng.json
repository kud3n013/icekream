{
    "version": "1.0.0",
    "description": "Privacy-respecting, hackable metasearch engine (deployed via Docker).",
    "homepage": "https://github.com/searxng/searxng",
    "license": "AGPL-3.0-only",
    "notes": [
        "SearXNG container is running at http://localhost:8888",
        "Use 'searxng status', 'searxng start', 'searxng stop', 'searxng restart', 'searxng logs', or 'searxng open' to manage the container."
    ],
    "url": "https://raw.githubusercontent.com/searxng/searxng/master/LICENSE#/searxng-stub.txt",
    "hash": "skip",
    "post_install": [
        "# Resolve Docker executable path",
        "$dockerCmd = Get-Command docker.exe -ErrorAction SilentlyContinue",
        "if (-not $dockerCmd) {",
        "    $dockerCandidates = @(",
        "        \"$env:ProgramFiles\\Docker\\Docker\\resources\\bin\\docker.exe\",",
        "        \"${env:ProgramFiles(x86)}\\Docker\\Docker\\resources\\bin\\docker.exe\",",
        "        \"$env:LOCALAPPDATA\\Programs\\Docker\\Docker\\resources\\bin\\docker.exe\"",
        "    )",
        "    foreach ($p in $dockerCandidates) {",
        "        if (Test-Path $p) { $dockerExe = $p; break }",
        "    }",
        "} else {",
        "    $dockerExe = $dockerCmd.Source",
        "}",
        "if (-not $dockerExe) {",
        "    throw 'Docker executable (docker.exe) not found. Please install Docker Desktop first.'",
        "}",
        "",
        "# Ensure Docker daemon is responsive",
        "& $dockerExe info *>$null 2>$null",
        "if ($LASTEXITCODE -ne 0) {",
        "    Write-Host 'Docker daemon is not running. Attempting to start Docker Desktop...' -ForegroundColor Yellow",
        "    $ddPath = \"$env:ProgramFiles\\Docker\\Docker\\Docker Desktop.exe\"",
        "    if (Test-Path $ddPath) { Start-Process $ddPath }",
        "    $timeout = 45; $elapsed = 0",
        "    while ($elapsed -lt $timeout) {",
        "        Start-Sleep -Seconds 3; $elapsed += 3",
        "        & $dockerExe info *>$null 2>$null",
        "        if ($LASTEXITCODE -eq 0) { break }",
        "    }",
        "}",
        "",
        "# Ensure container name uniqueness",
        "$existing = & $dockerExe ps -a --filter 'name=searxng' --format '{{.ID}}' 2>$null",
        "if ($existing) {",
        "    Write-Host 'Removing existing searxng container...' -ForegroundColor Yellow",
        "    & $dockerExe rm -f searxng *>$null 2>$null",
        "}",
        "",
        "# Ensure config directory in persist folder exists",
        "$configDir = \"$dir\\config\"",
        "if (-not (Test-Path $configDir)) { New-Item -ItemType Directory -Path $configDir -Force | Out-Null }",
        "",
        "# Pull and run SearXNG container",
        "Write-Host 'Pulling SearXNG Docker image...' -ForegroundColor Cyan",
        "& $dockerExe pull searxng/searxng:latest",
        "Write-Host 'Starting SearXNG container on port 8888...' -ForegroundColor Cyan",
        "& $dockerExe run -d --name searxng --restart=unless-stopped --publish 8888:8080 -v \"${configDir}:/etc/searxng\" searxng/searxng:latest",
        "",
        "# Create wrapper script for CLI management",
        "$cliScript = @'",
        "param([string]$Action = 'status')",
        "$docker = Get-Command docker.exe -ErrorAction SilentlyContinue",
        "if (-not $docker) {",
        "    $dockerExe = \"$env:ProgramFiles\\Docker\\Docker\\resources\\bin\\docker.exe\"",
        "} else {",
        "    $dockerExe = $docker.Source",
        "}",
        "switch ($Action.ToLower()) {",
        "    'start'   { & $dockerExe start searxng }",
        "    'stop'    { & $dockerExe stop searxng }",
        "    'restart' { & $dockerExe restart searxng }",
        "    'logs'    { & $dockerExe logs -f searxng }",
        "    'open'    { Start-Process 'http://localhost:8888' }",
        "    default   {",
        "        Write-Host 'SearXNG Container Status:' -ForegroundColor Cyan",
        "        & $dockerExe ps -a --filter 'name=searxng'",
        "        Write-Host \"`nAvailable actions: searxng [start|stop|restart|logs|status|open]\" -ForegroundColor Gray",
        "    }",
        "}",
        "'@",
        "Set-Content -Path \"$dir\\searxng.ps1\" -Value $cliScript -Encoding UTF8"
    ],
    "bin": "searxng.ps1",
    "persist": "config",
    "uninstaller": {
        "script": [
            "$dockerCmd = Get-Command docker.exe -ErrorAction SilentlyContinue",
            "$dockerExe = if ($dockerCmd) { $dockerCmd.Source } else { \"$env:ProgramFiles\\Docker\\Docker\\resources\\bin\\docker.exe\" }",
            "if (Test-Path $dockerExe) {",
            "    Write-Host 'Stopping and removing SearXNG container...' -ForegroundColor Yellow",
            "    & $dockerExe rm -f searxng 2>$null",
            "    Write-Host 'Removing SearXNG Docker image...' -ForegroundColor Yellow",
            "    & $dockerExe rmi searxng/searxng:latest 2>$null",
            "}"
        ]
    }
}
