{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "1.0.9256",
    "description": "Discord. All-in-one voice, video, and text chat service (non-portable installation).",
    "homepage": "https://discord.com",
    "license": {
        "identifier": "Freeware",
        "url": "https://discord.com/terms"
    },
    "architecture": {
        "64bit": {
            "url": "https://dl.discordapp.net/distro/app/stable/win/x64/1.0.9256/DiscordSetup.exe",
            "hash": "2d4c7dbf1ec9dae5e7e03db93a27f1d33efa64fdcbcd8aa4e3b83c1b46cf65b7"
        }
    },
    "pre_install": "Set-Content -Path \"$dir\\discord.cmd\" -Value \"@echo off`r`nstart \"\"\"\" \"\"%LOCALAPPDATA%\\Discord\\Update.exe\"\" --processStart Discord.exe %*\"",
    "installer": {
        "file": "DiscordSetup.exe",
        "args": "--silent"
    },
    "post_install": [
        "Stop-Process -Name 'Discord', 'Update' -Force -ErrorAction SilentlyContinue",
        "Start-Sleep -Seconds 1",
        "$discordDir = \"$env:LOCALAPPDATA\\Discord\"",
        "$appDir = Get-ChildItem -Path $discordDir -Directory -Filter 'app-*' -ErrorAction SilentlyContinue | Select-Object -Last 1",
        "if ($appDir -and (Test-Path \"$($appDir.FullName)\\installer.db\") -and (-not (Test-Path \"$discordDir\\installer.db\"))) {",
        "    Copy-Item \"$($appDir.FullName)\\installer.db\" \"$discordDir\\installer.db\" -Force",
        "}"
    ],
    "bin": [
        [
            "discord.cmd",
            "discord"
        ],
        [
            "discord.cmd",
            "discord-np"
        ]
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    Stop-Process -Name 'Discord', 'Update' -Force -ErrorAction SilentlyContinue",
            "    Start-Sleep -Seconds 1",
            "    $uninstaller = \"$env:LOCALAPPDATA\\Discord\\Update.exe\"",
            "    if (Test-Path $uninstaller) {",
            "        Start-Process -FilePath $uninstaller -ArgumentList '--uninstall', '-s' -Wait",
            "        Start-Sleep -Seconds 3",
            "    }",
            "    Stop-Process -Name 'Discord', 'Update' -Force -ErrorAction SilentlyContinue",
            "    if (Test-Path \"$env:LOCALAPPDATA\\Discord\") {",
            "        Remove-Item -Path \"$env:LOCALAPPDATA\\Discord\" -Recurse -Force -ErrorAction SilentlyContinue",
            "    }",
            "    $startMenuDir = \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\\Discord Inc\"",
            "    if (Test-Path $startMenuDir) {",
            "        Remove-Item -Path $startMenuDir -Recurse -Force -ErrorAction SilentlyContinue",
            "    }",
            "    $desktopLnk = [Environment]::GetFolderPath('Desktop') + '\\Discord.lnk'",
            "    if (Test-Path $desktopLnk) {",
            "        Remove-Item -Path $desktopLnk -Force -ErrorAction SilentlyContinue",
            "    }",
            "}"
        ]
    },
    "checkver": {
        "script": "(curl.exe -I -s -A 'Mozilla/5.0' 'https://discord.com/api/downloads/distributions/app/installers/latest?channel=stable&platform=win&arch=x64') | Where-Object { $_ -match 'location:' }",
        "regex": "/([\\d.]+)/DiscordSetup\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dl.discordapp.net/distro/app/stable/win/x64/$version/DiscordSetup.exe"
            }
        }
    }
}
