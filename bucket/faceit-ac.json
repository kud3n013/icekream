{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "2.1",
    "description": "FACEIT Anti-Cheat. Kernel-level security client required for competitive matchmaking on FACEIT.",
    "homepage": "https://www.faceit.com",
    "license": "Proprietary",
    "notes": [
        "FACEIT Anti-Cheat requires administrator privileges to install and uninstall (e.g. 'sudo scoop install faceit-ac').",
        "Mandatory system requirements: UEFI Mode, Secure Boot enabled, TPM 2.0, CPU Virtualization (VT-x/AMD-V), and VBS / Core Isolation.",
        "Documentation & Troubleshooting: https://support.faceit.com/hc/en-us/sections/360000035544-Anti-Cheat"
    ],
    "architecture": {
        "64bit": {
            "url": "https://anticheat-client.faceit-cdn.net/FACEITInstaller_64.exe",
            "hash": "4a9a81d0a4ddf42b5ff4f78bafa0b96a2da044dae91a3bafff0895ffeb3ed450"
        }
    },
    "installer": {
        "script": [
            "if (-not (is_admin)) {",
            "    error 'Administrator privileges are required to install FACEIT Anti-Cheat. Please run Scoop with sudo (e.g. `sudo scoop install faceit-ac`) or from an elevated PowerShell prompt.'",
            "    break",
            "}",
            "$installer = \"$dir\\FACEITInstaller_64.exe\"",
            "$logPath = \"$dir\\faceit_install.log\"",
            "$procArgs = @('/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART', '/SP-', '/MERGETASKS=!client', \"/LOG=`\"$logPath`\"\")",
            "$process = Start-Process -FilePath $installer -ArgumentList $procArgs -PassThru -Wait",
            "$targetExe = \"$env:ProgramFiles\\FACEIT AC\\faceitclient.exe\"",
            "$checkSettings = {",
            "    $missing = @()",
            "    $peType = (Get-ItemProperty -Path 'HKLM:\\System\\CurrentControlSet\\Control' -Name 'PEFirmwareType' -ErrorAction SilentlyContinue).PEFirmwareType",
            "    $isUefi = ($peType -eq 2) -or ($env:firmware_type -eq 'UEFI')",
            "    if (-not $isUefi) {",
            "        try { $null = Confirm-SecureBootUEFI; $isUefi = $true } catch { if ($_.Exception.Message -match 'privilege') { $isUefi = $true } }",
            "    }",
            "    if (-not $isUefi) {",
            "        $missing += 'UEFI Boot Mode: System is running in Legacy BIOS mode (UEFI mode with GPT partition is required).'",
            "    }",
            "    $secBoot = $false",
            "    try { $secBoot = Confirm-SecureBootUEFI -ErrorAction Stop } catch { $secBoot = $false }",
            "    if (-not $secBoot) {",
            "        $missing += 'Secure Boot: Secure Boot is disabled or unsupported (must be enabled in BIOS/UEFI).'",
            "    }",
            "    $tpm = Get-Tpm -ErrorAction SilentlyContinue",
            "    if (-not ($tpm -and $tpm.TpmPresent)) {",
            "        $missing += 'TPM 2.0: TPM was not detected or is disabled in BIOS/UEFI (enable fTPM/Intel PTT in BIOS).'",
            "    } elseif (-not $tpm.TpmReady) {",
            "        $missing += 'TPM 2.0: TPM is present but not ready/provisioned (verify TPM state in tpm.msc).'",
            "    } else {",
            "        $tpmWmi = Get-CimInstance -Namespace 'root\\cimv2\\security\\microsofttpm' -ClassName Win32_Tpm -ErrorAction SilentlyContinue",
            "        if ($tpmWmi -and $tpmWmi.SpecVersion -notlike '2.0*') {",
            "            $missing += \"TPM 2.0: Detected TPM version '$($tpmWmi.SpecVersion)' (FACEIT Anti-Cheat requires version 2.0).\"",
            "        }",
            "    }",
            "    $cpu = Get-CimInstance -ClassName Win32_Processor -ErrorAction SilentlyContinue | Select-Object -First 1",
            "    if ($cpu -and $cpu.VirtualizationFirmwareEnabled -eq $false) {",
            "        $missing += 'Hardware Virtualization: Intel VT-x or AMD-V (SVM) is disabled in BIOS/UEFI.'",
            "    }",
            "    $dg = Get-CimInstance -Namespace 'root\\Microsoft\\Windows\\DeviceGuard' -ClassName Win32_DeviceGuard -ErrorAction SilentlyContinue",
            "    if ($dg -and $dg.VirtualizationBasedSecurityStatus -ne 2) {",
            "        $missing += \"Virtualization-based Security (VBS): VBS is not running (status: $($dg.VirtualizationBasedSecurityStatus)). Required for DMA protection.\"",
            "    }",
            "    $startOpts = (Get-ItemProperty -Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Control' -Name 'SystemStartOptions' -ErrorAction SilentlyContinue).SystemStartOptions",
            "    if ($startOpts -match 'TESTSIGNING') {",
            "        $missing += 'Windows Test Mode: TESTSIGNING is active. Run `bcdedit /set testsigning off` and reboot.'",
            "    }",
            "    if ($startOpts -match 'DEBUG') {",
            "        $missing += 'Kernel Debugging: DEBUG mode is active. Run `bcdedit /debug off` and reboot.'",
            "    }",
            "    return $missing",
            "}",
            "$missingSettings = & $checkSettings",
            "if ($process.ExitCode -ne 0 -or -not (Test-Path $targetExe)) {",
            "    error \"FACEIT Anti-Cheat installer failed (exit code: $($process.ExitCode)).\"",
            "    if ($missingSettings.Count -gt 0) {",
            "        error 'Detected missing or misconfigured system settings required by FACEIT Anti-Cheat:'",
            "        foreach ($setting in $missingSettings) {",
            "            error \"  - $setting\"",
            "        }",
            "    }",
            "    if (Test-Path $logPath) {",
            "        $logErrors = Get-Content $logPath | Where-Object { $_ -match 'Exception|Failed|Error' } | Select-Object -Last 10",
            "        if ($logErrors) {",
            "            error 'Installer log details:'",
            "            $logErrors | ForEach-Object { error \"  $_\" }",
            "        }",
            "    }",
            "    error 'Please review FACEIT Anti-Cheat requirements: https://support.faceit.com/hc/en-us/sections/360000035544-Anti-Cheat'",
            "    break",
            "} elseif ($missingSettings.Count -gt 0) {",
            "    warn 'FACEIT Anti-Cheat installed, but the following required system settings are not satisfied:'",
            "    foreach ($setting in $missingSettings) {",
            "        warn \"  - $setting\"",
            "    }",
            "    warn 'FACEIT Anti-Cheat may not function properly until these settings are enabled in BIOS/UEFI.'",
            "}"
        ]
    },
    "post_install": [
        "Remove-Item \"$dir\\FACEITInstaller_64.exe\", \"$dir\\faceit_install.log\" -Force -ErrorAction SilentlyContinue"
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    if (-not (is_admin)) {",
            "        error 'Administrator privileges are required to uninstall FACEIT Anti-Cheat. Please run Scoop from an elevated PowerShell prompt.'",
            "        break",
            "    }",
            "    $uninstaller = \"$env:ProgramFiles\\FACEIT AC\\unins000.exe\"",
            "    if (Test-Path $uninstaller) {",
            "        Start-Process -FilePath $uninstaller -ArgumentList '/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART' -Wait",
            "    }",
            "}"
        ]
    }
}
