{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "2.11.1",
    "description": "FACEIT Desktop Client. Competitive gaming platform for Counter-Strike 2 and other esports titles.",
    "homepage": "https://www.faceit.com",
    "license": "Proprietary",
    "notes": "FACEIT Anti-Cheat is not included and must be installed separately if prompted.",
    "architecture": {
        "64bit": {
            "url": "https://faceit-client.faceit-cdn.net/release/FACEIT-2.11.1-full.nupkg",
            "hash": "sha1:05a15691692f3a5ac6ec26cc4cb32660d8274927"
        }
    },
    "extract_dir": "lib\\net45",
    "shortcuts": [
        [
            "FACEIT.exe",
            "FACEIT"
        ]
    ],
    "checkver": {
        "url": "https://faceit-client.faceit-cdn.net/release/RELEASES",
        "regex": "FACEIT-([\\d.]+)-full\\.nupkg",
        "reverse": true
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://faceit-client.faceit-cdn.net/release/FACEIT-$version-full.nupkg",
                "hash": {
                    "url": "$baseurl/RELEASES"
                }
            }
        }
    }
}
